# ═══════════════════════════════════════════════════════════════════════════
#  URAAS — Environment Variables Template
#  Copy this file to .env for local development:
#    cp .env.example .env
#  NEVER commit .env to git. Set production values as server/platform env vars.
# ═══════════════════════════════════════════════════════════════════════════

# ── Runtime environment ──────────────────────────────────────────────────────
# Set to "production" on the UNILAG server / Render / Docker.
# In production, Config.validate() will reject weak secrets and warn about CORS.
URAAS_ENV=development


# ── Database ─────────────────────────────────────────────────────────────────
# Local dev: use SQLite (default — no config needed).
# Production (Render): injected automatically from the linked PostgreSQL instance.
# Docker/UNILAG server: set to the PostgreSQL connection string below.
#
DATABASE_URL=sqlite:///uraas.db
# DATABASE_URL=postgresql://uraas_user:STRONG_PASSWORD@localhost:5432/uraas_db


# ── Flask session secret ──────────────────────────────────────────────────────
# Generate a strong key for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production — startup will fail with the default value.
#
DASHBOARD_SECRET_KEY=dev-secret-key


# ── Authentication ────────────────────────────────────────────────────────────
# Two roles: admin (full control, crawler, exports) and viewer (read-only).
#
# Generate password hashes:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g('YOUR_PASSWORD'))"
#
# ADMIN_PASSWORD_HASH is REQUIRED in production — startup will fail if empty.
# VIEWER_PASSWORD_HASH is optional — leave empty to disable the viewer account.
#
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Example hash for testing (password = "changeme"):
# ADMIN_PASSWORD_HASH=scrypt:32768:8:1$SALT$HASH

VIEWER_USERNAME=viewer
VIEWER_PASSWORD_HASH=
# Leave VIEWER_PASSWORD_HASH empty to disable viewer login entirely.


# ── CORS / WebSocket origins ──────────────────────────────────────────────────
# Comma-separated list of allowed origins for the Flask-SocketIO handshake.
# Local dev: localhost ports.
# Production: set to the actual UNILAG HTTPS domain(s).
# WARNING: a startup warning will fire in production if localhost remains here.
#
DASHBOARD_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Production example:
# DASHBOARD_CORS_ORIGINS=https://repository.unilag.edu.ng


# ── Storage ───────────────────────────────────────────────────────────────────
# Local path where downloaded PDFs are stored.
# Render: /opt/render/project/storage/pdfs (persistent disk)
# Docker: /app/storage/pdfs (mounted volume)
STORAGE_PATH=./storage
STORAGE_MIN_FREE_GB=10.0


# ── Redis (optional — used by Flask-Limiter in distributed mode) ──────────────
# Local dev: not required (Flask-Limiter uses in-memory storage by default).
# Production with multiple gunicorn workers: set to a Redis instance so rate
# limits are shared across all workers.
#
# REDIS_URL=redis://localhost:6379/0


# ── OpenAlex API ──────────────────────────────────────────────────────────────
# Keyless access is being retired by OpenAlex. Register at openalex.org/settings/api.
OPENALEX_API_KEY=
OPENALEX_MAILTO=admin@unilag.edu.ng

# ── Other source-spider API keys (all optional — spiders degrade gracefully
# without them, just at a lower rate limit / for CORE, disabled entirely) ─────
# Semantic Scholar: api.semanticscholar.org/product/api — raises the free-tier
# rate limit; without it expect frequent 429s (confirmed live 2026-07-18).
S2_API_KEY=
# CORE: core.ac.uk/services/api — required for core_spider.py to run at all.
CORE_API_KEY=
# NCBI/PubMed E-utilities: ncbi.nlm.nih.gov/account — raises the keyless
# 3 req/s ceiling; pubmed_spider.py works fine without it at the lower rate.
NCBI_API_KEY=
LENS_API_KEY=


# ── ARK Persistent Identifiers ───────────────────────────────────────────────
# 99999 is the official test NAAN. Replace with the registered Africa PID Alliance
# NAAN once assigned. ARK_SHOULDER must use betanumeric alphabet (no vowels / 'l').
ARK_NAAN=99999
ARK_SHOULDER=z1


# ── Crawler tuning ────────────────────────────────────────────────────────────
RATE_LIMIT_DELAY=2.0
MAX_DEPTH=10
CONCURRENT_REQUESTS=16


# ── HuggingFace model cache (for embedding model) ────────────────────────────
# Render: /opt/render/project/storage/hf-cache (persistent across deploys)
# HF_HOME=/opt/render/project/storage/hf-cache


# ── Live DSpace IR connection (api-ir.unilag.edu.ng) ─────────────────────────
# The backend URL is the Spring Boot API, NOT the Angular frontend.
# Credentials: a DSpace account with submission rights on the target collections.
DSPACE_API_URL=https://api-ir.unilag.edu.ng/server
DSPACE_USERNAME=
DSPACE_PASSWORD=
# DSpace collection UUID for automatic crawl-time deposit.
# Leave blank to use the first submittable collection; set explicitly to target a specific one.
DSPACE_COLLECTION_UUID=


# ── Africa PID Alliance DOCiD™ registration (docid.africapidalliance.org) ────
# Real DOCiD assignment API. Base URL is defaulted in code to the confirmed
# real public API (https://docid.africapidalliance.org/api) — DOCID_API_URL
# only needs setting to override that (e.g. a staging environment). Leave
# EMAIL/PASSWORD blank to keep registration disabled (the crawler falls back
# to uraas.utils.docid_generator's local placeholder IDs); set them once you
# have a real account (register at docid.africapidalliance.org/register).
DOCID_API_URL=
DOCID_EMAIL=
DOCID_PASSWORD=


# ── Batch deposit approval emails (SMTP) ─────────────────────────────────────
# Before any batch is pushed to the real IR, an approval email is sent to the
# address the admin types in. The link in that email must reach this server.
#
# DASHBOARD_BASE_URL: full public URL of this URAAS dashboard (no trailing slash).
# Used to build the approve/reject links embedded in approval emails.
# Local dev: http://localhost:8080   Production: https://your-uraas-domain.example
DASHBOARD_BASE_URL=http://localhost:8080

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
# Friendly "From" address shown in the approval email
SMTP_FROM=URAAS IR Deposit <uraas-bot@unilag.edu.ng>
