# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/

# Secrets: ignore every .env variant (including .env.prod) but keep the template.
.env
.env.*
!.env.example

# Claude Code local settings (may contain tokens/keys from shell history)
.claude/settings.local.json

# Databases and their backups
*.db
*.db-journal
*.sqlite
*.bak

# Crawled content and generated data
storage/
# data/ holds staff rosters naming real people - ignored wholesale except
# for the README explaining what belongs there. A bare `data/` rule would
# stop git descending into the directory at all, so the README could only
# ever be force-added; `data/*` lets the negation below take effect.
data/*
!data/README.md
logs/
exports.csv
senate.csv

# Local working material: drafts, decks, one-off scripts. Never deployed.
scratch/
docs/assets/

# TLS certs / keys (self-signed dry-run certs, real certs)
deploy/nginx/ssl/

# IDEs
.vscode/
.idea/

# Test and coverage artifacts
.pytest_cache/
.mypy_cache/
pytest_out*
.coverage
coverage.xml
htmlcov/
tests/reports/

# Logs and temp files
*.log
dashboard.log
test_write.txt
